#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '== %s\n' "$1"; }

step "rustfmt"
cargo fmt --check

step "clippy"
cargo clippy --all-targets --quiet -- -D warnings

step "tests"
cargo test --quiet

step "typescript"
(cd app && ./node_modules/.bin/tsc --noEmit -p .)

step "eslint"
(cd app && ./node_modules/.bin/eslint --max-warnings 0 src)

if command -v swift >/dev/null && [ "$(uname)" = Darwin ]; then
  step "swift"
  (cd mac && swift build --quiet)
fi

step "app parity"
endpoints() { grep -rhoE "/api/[a-z0-9_/-]+" "$1" | sort -u; }
gap=$(diff <(endpoints app/src) <(endpoints mac/Sources) | grep '^[<>]' || true)
if [ -n "$gap" ]; then
  echo "API endpoints used by only one app (< web, > mac):"
  echo "$gap"
  exit 1
fi

step "shell syntax"
for f in install.sh mac/build.sh skill/*.sh scripts/check; do bash -n "$f"; done

slop="${SLOP_CHECK:-$HOME/.claude/hooks/slop_check.py}"
if [ -f "$slop" ]; then
  step "docs and comments"
  git ls-files -z --cached --others --exclude-standard | xargs -0 python3 -I "$slop"
else
  printf '== docs and comments (skipped; set SLOP_CHECK to run the local linter)\n'
fi

echo "all checks passed"
