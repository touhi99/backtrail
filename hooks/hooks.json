{
  "description": "Backtrail brief at session start and indexing at session end",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bt.sh",
            "args": [
              "brief"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bt.sh",
            "args": [
              "end"
            ]
          }
        ]
      }
    ]
  }
}
